diff --git a/apps/solidcraft-web/src/scad_bridge.rs b/apps/solidcraft-web/src/scad_bridge.rs
new file mode 100644
index 0000000000000000000000000000000000000000..340536d7e4cd95c000ed485034443cc1ab058add
--- /dev/null
+++ b/apps/solidcraft-web/src/scad_bridge.rs
@@ -0,0 +1,44 @@
+//! Hands SCAD files and actions to the SCADBridge overlay loaded in the page.
+//!
+//! The bridge owns parsing, compilation and the SolidCraft command plan, so this module
+//! only passes text and names to JavaScript and remembers the writable file handle for
+//! write-back.
+
+use wasm_bindgen::{JsCast as _, JsValue};
+use web_sys::FileSystemFileHandle;
+
+fn global(name: &str) -> Option<js_sys::Function> {
+    let window = web_sys::window()?;
+    js_sys::Reflect::get(&window, &name.into())
+        .ok()
+        .and_then(|value| value.dyn_into::<js_sys::Function>().ok())
+}
+
+/// Ask the SCADBridge overlay to open this source. Returns false when the overlay is not
+/// loaded, so the caller can report it instead of silently doing nothing.
+pub fn open(name: &str, source: &str) -> bool {
+    let Some(function) = global("scadbridgeOpenFile") else { return false };
+    function
+        .call2(&JsValue::UNDEFINED, &JsValue::from_str(source), &JsValue::from_str(name))
+        .is_ok()
+}
+
+/// Export the current design as SCAD through the overlay.
+pub fn export() -> bool {
+    let Some(function) = global("scadbridgeExportScad") else { return false };
+    function.call0(&JsValue::UNDEFINED).is_ok()
+}
+
+/// Keep the picked file's handle so the overlay can write back into it.
+pub fn remember_handle(handle: &FileSystemFileHandle) {
+    if let Some(window) = web_sys::window() {
+        let _ = js_sys::Reflect::set(&window, &"scadbridgeFileHandle".into(), handle.as_ref());
+    }
+}
+
+/// Drop a handle from an earlier pick.
+pub fn clear_handle() {
+    if let Some(window) = web_sys::window() {
+        let _ = js_sys::Reflect::set(&window, &"scadbridgeFileHandle".into(), &JsValue::NULL);
+    }
+}
